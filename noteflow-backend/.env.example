SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

USE_POSTGRES=False
DB_NAME=noteflow
DB_USER=noteflow
DB_PASSWORD=noteflow
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=noteflow-files
SUPABASE_SIGNED_URL_EXPIRY_SECONDS=300
# Set to True only if your bucket is actually public - skips signed-URL
# generation for faster downloads/previews, but access-request approval
# becomes app-level only (no expiry, no revocation on the file itself).
SUPABASE_BUCKET_PUBLIC=True

NOTEFLOW_MAX_FILE_SIZE_MB=25

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@noteflow.app

FRONTEND_URL=http://localhost:5173
